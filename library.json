    "url": "https://github.com/RadCom-Comunity/Modem-a7880G-library.git"
  },
  "homepage": "https://github.com/RadCom-Comunity/Modem-a7880G-library",
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
